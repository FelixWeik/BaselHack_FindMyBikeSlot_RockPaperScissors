// Template: copy to secrets.h and fill in. secrets.h is git-ignored.
#pragma once

// All networks the camera may use (2.4 GHz only). It connects to the strongest one in range.
#define WIFI_NETWORKS \
  { \
    {"your-wifi-name", "your-wifi-password"}, \
    {"phone-hotspot-name", "hotspot-password"}, \
  }

// Password for over-the-air firmware updates. Generate one, e.g.:
//   python3 -c "import secrets; print(secrets.token_urlsafe(12))"
#define OTA_PASSWORD  "change-me"

// Optional, per person: uncomment to test with your own laptop without touching config.h.
// scripts/start.sh prints the values for your machine.
